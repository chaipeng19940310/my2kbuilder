# My2KBuilder — production build-time env (non-secret; committed intentionally).
# R10.5 APPROVED_FOR_PRODUCTION_RELEASE 后由 R11 落地：
# canonical / robots sitemap 行 / sitemap.xml 绝对 URL 的 build-time host。
CANONICAL_HOST=my2kbuilder.com

# R12.5/R12.6 consent-gated analytics — public install identifiers (non-secret;
# committed intentionally, per owner-review/analytics-public-ids-v2.md).
# Consent contract: no consent => 0 scripts / 0 requests; after consent only
# these configured providers load, exactly once (lib/analytics.ts).
# R12.6 (Owner 2026-08-27 新指令): Plausible 改用标准 snippet
#   <script defer data-domain="my2kbuilder.com" src="https://plausible.shipsolo.io/js/script.js">
# 旧 managed pa-*.js 接入已作废。
PLAUSIBLE_SCRIPT_URL=https://plausible.shipsolo.io/js/script.js
PLAUSIBLE_DATA_DOMAIN=my2kbuilder.com
GA4_MEASUREMENT_ID=G-LDMWX00TXG
CLARITY_PROJECT_ID=y7k97rca9u
